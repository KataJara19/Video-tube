# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env y completa los valores.
# .env está en .gitignore: NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# PostgreSQL: cada dato por separado (la URL la arma src/database/connection.py)
#   Local : DB_HOST=localhost, DB_SSLMODE vacío
#   AWS   : DB_HOST=<punto de enlace de RDS>, DB_SSLMODE=require
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD
DB_HOST=localhost
DB_PORT=5432
DB_NAME=videotube
DB_SSLMODE=

# Firma de tokens JWT (genera uno con: python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=cambia-esta-clave
JWT_EXPIRE_HOURS=24

# Almacenamiento de archivos
#   local : guarda en backend/uploads (desarrollo)
#   s3    : sube a los buckets S3 (EC2, credenciales vía IAM Role)
STORAGE_MODE=local
PUBLIC_API_URL=http://localhost:8000

# Solo para STORAGE_MODE=s3
AWS_REGION=us-east-1
S3_VIDEOS_BUCKET=
S3_THUMBNAILS_BUCKET=
S3_URL_EXPIRES_SECONDS=3600

# Orígenes permitidos (URL del frontend), separados por coma
CORS_ORIGINS=http://localhost:5173

MAX_VIDEO_MB=100
MAX_THUMBNAIL_MB=5
